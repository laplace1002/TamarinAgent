theory CCITT_X509

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, h/1, pair/2, pk/1, sid/1, sign/2,
           snd/1, true/0, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

heuristic: p

lemma Secrecy:
  all-traces
  "(∀ A B k #i. (Secret_A( A, B, k ) @ #i) ⇒ (¬(∃ #j. K( k ) @ #j))) ∧
   (∀ A B k #i. (Secret_B( A, B, k ) @ #i) ⇒ (¬(∃ #j. K( k ) @ #j)))"
/*
guarded formula characterizing all counter-examples:
"((∃ A B k #i. (Secret_A( A, B, k ) @ #i) ∧ ∃ #j. (K( k ) @ #j)) ∨
  (∃ A B k #i. (Secret_B( A, B, k ) @ #i) ∧ ∃ #j. (K( k ) @ #j)))"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ A B SID k #i.
    (Commit_B( A, B, SID, k ) @ #i) ⇒
    ((∃ #j. (Running_A( A, B, SID, k ) @ #j) ∧ (#j < #i)) ∧
     (∀ #i1.1 #i2.1.
       ((Commit_B( A, B, SID, k ) @ #i1.1) ∧
        (Commit_B( A, B, SID, k ) @ #i2.1)) ⇒
       (i1 = i2)))"
/*
guarded formula characterizing all counter-examples:
"∃ A B SID k #i.
  (Commit_B( A, B, SID, k ) @ #i)
 ∧
  ((∀ #j. (Running_A( A, B, SID, k ) @ #j) ⇒ ¬(#j < #i)) ∨
   (∃ #i1.1 #i2.1.
     (Commit_B( A, B, SID, k ) @ #i1.1) ∧ (Commit_B( A, B, SID, k ) @ #i2.1)
    ∧
     ¬(i1 = i2)))"
*/
by sorry

lemma agreement_B:
  all-traces
  "∀ A B SID k #i.
    (Commit_B( A, B, SID, k ) @ #i) ⇒
    (∃ #j. (Running_A( A, B, SID, k ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A B SID k #i.
  (Commit_B( A, B, SID, k ) @ #i)
 ∧
  ∀ #j. (Running_A( A, B, SID, k ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma Session_key_honest_setup:
  exists-trace
  "∃ A B SID k #i #j.
    (Running_A( A, B, SID, k ) @ #i) ∧ (Commit_B( A, B, SID, k ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ A B SID k #i #j.
  (Running_A( A, B, SID, k ) @ #i) ∧ (Commit_B( A, B, SID, k ) @ #j)"
*/
by sorry

