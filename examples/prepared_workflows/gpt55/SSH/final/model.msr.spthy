theory SSH

begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: HASH/1, fst/1, h/1, kdf_extend/3, kdf_initial/4, pair/2, pk/1,
           sdec/2, senc/2, sign/2, snd/1, take_prefix/2, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

heuristic: p

lemma secretP:
  all-traces
  "∀ c s k hval sid kmat #i.
    (Secret_C( c, s, k, hval, sid, kmat, 'verified_hostkey' ) @ #i) ⇒
    ((((¬(∃ #j. K( k ) @ #j)) ∧ (¬(∃ #j. K( hval ) @ #j))) ∧
      (¬(∃ #j. K( sid ) @ #j))) ∧
     (¬(∃ #j. K( kmat ) @ #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ c s k hval sid kmat #i.
  (Secret_C( c, s, k, hval, sid, kmat, 'verified_hostkey' ) @ #i)
 ∧
  ((∃ #j. (K( k ) @ #j)) ∨
   (∃ #j. (K( hval ) @ #j)) ∨
   (∃ #j. (K( sid ) @ #j)) ∨
   (∃ #j. (K( kmat ) @ #j)))"
*/
by sorry

lemma injPS:
  all-traces
  "∀ c s hval k sid pks #i.
    (Commit_C_ServerAuth( c, s, hval, k, sid, pks ) @ #i) ⇒
    (∃ e f #j.
      ((ServerSendsSignedExchange( s, c, hval, k, pks, e, f ) @ #j) ∧
       (#j < #i)) ∧
      (∀ #i2.
        (Commit_C_ServerAuth( c, s, hval, k, sid, pks ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ c s hval k sid pks #i.
  (Commit_C_ServerAuth( c, s, hval, k, sid, pks ) @ #i)
 ∧
  ∀ e f #j.
   (ServerSendsSignedExchange( s, c, hval, k, pks, e, f ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ #i2.
      (Commit_C_ServerAuth( c, s, hval, k, sid, pks ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

lemma injSP:
  all-traces
  "∀ s c hval k e f #i.
    (ServerFinishedKeyExchange( s, c, hval, k, e, f ) @ #i) ⇒
    (∃ vc vs ic isval #j.
      ((ClientEphemeralSent( c, s, e, vc, vs, ic, isval ) @ #j) ∧ (#j < #i)) ∧
      (∀ #i2.
        (ServerFinishedKeyExchange( s, c, hval, k, e, f ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ s c hval k e f #i.
  (ServerFinishedKeyExchange( s, c, hval, k, e, f ) @ #i)
 ∧
  ∀ vc vs ic isval #j.
   (ClientEphemeralSent( c, s, e, vc, vs, ic, isval ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ #i2.
      (ServerFinishedKeyExchange( s, c, hval, k, e, f ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

lemma secretS:
  all-traces
  "∀ s c k hval sid kmat #i.
    (Secret_S( s, c, k, hval, sid, kmat ) @ #i) ⇒
    ((((¬(∃ #j. K( k ) @ #j)) ∧ (¬(∃ #j. K( hval ) @ #j))) ∧
      (¬(∃ #j. K( sid ) @ #j))) ∧
     (¬(∃ #j. K( kmat ) @ #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ s c k hval sid kmat #i.
  (Secret_S( s, c, k, hval, sid, kmat ) @ #i)
 ∧
  ((∃ #j. (K( k ) @ #j)) ∨
   (∃ #j. (K( hval ) @ #j)) ∨
   (∃ #j. (K( sid ) @ #j)) ∨
   (∃ #j. (K( kmat ) @ #j)))"
*/
by sorry

lemma executableS2:
  exists-trace
  "∃ c s k hval sid iv_c2s iv_s2c enc_c2s enc_s2c mac_c2s mac_s2c #i #j.
    ((ServerKeysDerived( s, c, k, hval, sid, iv_c2s, iv_s2c, enc_c2s,
                         enc_s2c, mac_c2s, mac_s2c
      ) @ #i) ∧
     (ClientKeysDerived( c, s, k, hval, sid, iv_c2s, iv_s2c, enc_c2s, enc_s2c,
                         mac_c2s, mac_s2c
      ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ c s k hval sid iv_c2s iv_s2c enc_c2s enc_s2c mac_c2s mac_s2c #i #j.
  (ServerKeysDerived( s, c, k, hval, sid, iv_c2s, iv_s2c, enc_c2s, enc_s2c,
                      mac_c2s, mac_s2c
   ) @ #i) ∧
  (ClientKeysDerived( c, s, k, hval, sid, iv_c2s, iv_s2c, enc_c2s, enc_s2c,
                      mac_c2s, mac_s2c
   ) @ #j)
 ∧
  #i < #j"
*/
by sorry

