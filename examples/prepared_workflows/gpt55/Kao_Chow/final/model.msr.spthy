theory Kao_Chow

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma AUTO_typing [sources]:
  all-traces
  "(((∀ m #i.
       (IN_M1( m ) @ #i) ⇒
       ((∃ #j. (OUT_M1( m ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i)))) ∧
     (∀ m #i.
       (IN_M2( m ) @ #i) ⇒
       ((∃ #j. (OUT_M2( m ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
    (∀ m #i.
      (IN_M3( m ) @ #i) ⇒
      ((∃ #j. (OUT_M3( m ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
   (∀ m #i.
     (IN_M4( m ) @ #i) ⇒
     ((∃ #j. (OUT_M4( m ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m #i.
    (IN_M1( m ) @ #i)
   ∧
    (∀ #j. (OUT_M1( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M3( m ) @ #i)
   ∧
    (∀ #j. (OUT_M3( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M4( m ) @ #i)
   ∧
    (∀ #j. (OUT_M4( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))))"
*/
by sorry

lemma executability:
  exists-trace
  "∃ na nb kab #i #j #k #l #m #n.
    (((((((((((Start_A( 'A', 'B', na ) @ #i) ∧
              (Server_Issue( 'S', 'A', 'B', na, kab ) @ #j)) ∧
             (Running_B( 'A', 'B', na, nb, kab ) @ #k)) ∧
            (Commit_A( 'A', 'B', na, nb, kab ) @ #l)) ∧
           (Running_A( 'A', 'B', na, nb, kab ) @ #m)) ∧
          (Commit_B( 'A', 'B', na, nb, kab ) @ #n)) ∧
         (#i < #j)) ∧
        (#j < #k)) ∧
       (#k < #l)) ∧
      (#k < #m)) ∧
     (#l < #n)) ∧
    (#m < #n)"
/*
guarded formula characterizing all satisfying traces:
"∃ na nb kab #i #j #k #l #m #n.
  (Start_A( 'A', 'B', na ) @ #i) ∧
  (Server_Issue( 'S', 'A', 'B', na, kab ) @ #j) ∧
  (Running_B( 'A', 'B', na, nb, kab ) @ #k) ∧
  (Commit_A( 'A', 'B', na, nb, kab ) @ #l) ∧
  (Running_A( 'A', 'B', na, nb, kab ) @ #m) ∧
  (Commit_B( 'A', 'B', na, nb, kab ) @ #n)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l) ∧ (#k < #m) ∧ (#l < #n) ∧ (#m < #n)"
*/
by sorry

lemma secrecy:
  all-traces
  "∀ a b kab #i. (Secret( a, b, kab ) @ #i) ⇒ (¬(∃ #j. K( kab ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab #i. (Secret( a, b, kab ) @ #i) ∧ ∃ #j. (K( kab ) @ #j)"
*/
by sorry

lemma noninjectiveagreement_B:
  all-traces
  "∀ a b na nb kab #i.
    (Commit_B( a, b, na, nb, kab ) @ #i) ⇒
    (∃ #j. (Running_A( a, b, na, nb, kab ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ a b na nb kab #i.
  (Commit_B( a, b, na, nb, kab ) @ #i)
 ∧
  ∀ #j. (Running_A( a, b, na, nb, kab ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma noninjectiveagreement_A:
  all-traces
  "∀ a b na nb kab #i.
    (Commit_A( a, b, na, nb, kab ) @ #i) ⇒
    (∃ #j. (Running_B( a, b, na, nb, kab ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ a b na nb kab #i.
  (Commit_A( a, b, na, nb, kab ) @ #i)
 ∧
  ∀ #j. (Running_B( a, b, na, nb, kab ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ a b na nb kab #i.
    (Commit_B( a, b, na, nb, kab ) @ #i) ⇒
    (∃ #j.
      (((Running_A( a, b, na, nb, kab ) @ #j) ∧ (#j < #i)) ∧
       (∀ #j2. (Running_A( a, b, na, nb, kab ) @ #j2) ⇒ (#j2 = #j))) ∧
      (∀ #i2. (Commit_B( a, b, na, nb, kab ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b na nb kab #i.
  (Commit_B( a, b, na, nb, kab ) @ #i)
 ∧
  ∀ #j.
   (Running_A( a, b, na, nb, kab ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ #j2. (Running_A( a, b, na, nb, kab ) @ #j2) ∧ ¬(#j2 = #j)) ∨
    (∃ #i2. (Commit_B( a, b, na, nb, kab ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

lemma injectiveagreement_A:
  all-traces
  "∀ a b na nb kab #i.
    (Commit_A( a, b, na, nb, kab ) @ #i) ⇒
    (∃ #j.
      (((Running_B( a, b, na, nb, kab ) @ #j) ∧ (#j < #i)) ∧
       (∀ #j2. (Running_B( a, b, na, nb, kab ) @ #j2) ⇒ (#j2 = #j))) ∧
      (∀ #i2. (Commit_A( a, b, na, nb, kab ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b na nb kab #i.
  (Commit_A( a, b, na, nb, kab ) @ #i)
 ∧
  ∀ #j.
   (Running_B( a, b, na, nb, kab ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ #j2. (Running_B( a, b, na, nb, kab ) @ #j2) ∧ ¬(#j2 = #j)) ∨
    (∃ #i2. (Commit_A( a, b, na, nb, kab ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

