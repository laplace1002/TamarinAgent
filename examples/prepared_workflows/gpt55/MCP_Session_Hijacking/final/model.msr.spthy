theory MCP_Session_Hijacking

begin

// Function signature and definition of the equational theory E

functions: async_or_resumed_response/2, call/2, connect_or_auth/1,
           enqueue/2, fst/1, h/1, pair/2, poll/1, queue_event/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma session_hijack_prompt_injection_reachable:
  exists-trace
  "∃ sid payload #i #j #k #l #m #n.
    ((((((((((SessionCreated( 'ServerA', 'Client', sid ) @ #i) ∧
             (AttackerObtainsSession( 'Attacker', sid ) @ #j)) ∧
            (EventEnqueued( 'ServerB', sid, payload ) @ #k)) ∧
           (QueuePolled( 'ServerA', sid ) @ #l)) ∧
          (PayloadDelivered( 'ServerA', 'Client', sid, payload ) @ #m)) ∧
         (ClientActsOnPayload( 'Client', payload ) @ #n)) ∧
        (#i < #j)) ∧
       (#j < #k)) ∧
      (#k < #l)) ∧
     (#l < #m)) ∧
    (#m < #n)"
/*
guarded formula characterizing all satisfying traces:
"∃ sid payload #i #j #k #l #m #n.
  (SessionCreated( 'ServerA', 'Client', sid ) @ #i) ∧
  (AttackerObtainsSession( 'Attacker', sid ) @ #j) ∧
  (EventEnqueued( 'ServerB', sid, payload ) @ #k) ∧
  (QueuePolled( 'ServerA', sid ) @ #l) ∧
  (PayloadDelivered( 'ServerA', 'Client', sid, payload ) @ #m) ∧
  (ClientActsOnPayload( 'Client', payload ) @ #n)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l) ∧ (#l < #m) ∧ (#m < #n)"
*/
by sorry

lemma session_hijack_impersonation_reachable:
  exists-trace
  "∃ sid request #i #j #k #l.
    ((((((SessionCreated( 'MCPServer', 'Client', sid ) @ #i) ∧
         (AttackerObtainsSession( 'Attacker', sid ) @ #j)) ∧
        (CallAcceptedAsSession( 'MCPServer', 'Attacker', 'Client', sid, request
         ) @ #k)) ∧
       (UnauthorizedAction( 'MCPServer', 'Attacker', 'Client', sid, request
        ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ sid request #i #j #k #l.
  (SessionCreated( 'MCPServer', 'Client', sid ) @ #i) ∧
  (AttackerObtainsSession( 'Attacker', sid ) @ #j) ∧
  (CallAcceptedAsSession( 'MCPServer', 'Attacker', 'Client', sid, request
   ) @ #k) ∧
  (UnauthorizedAction( 'MCPServer', 'Attacker', 'Client', sid, request
   ) @ #l)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l)"
*/
by sorry

lemma accepted_inbound_requests_are_authorized:
  all-traces
  "(∀ server actor client sid request #i.
     (CallAcceptedAsSession( server, actor, client, sid, request ) @ #i) ⇒
     (∃ #j.
       (AuthorizedInboundRequest( server, actor, client, sid, request ) @ #j) ∧
       (#j < #i))) ∧
   (∀ serverB sid payload #i.
     (EventEnqueued( serverB, sid, payload ) @ #i) ⇒
     (∃ actor #j.
       (AuthorizedInboundEvent( serverB, actor, sid, payload ) @ #j) ∧
       (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"((∃ server actor client sid request #i.
    (CallAcceptedAsSession( server, actor, client, sid, request ) @ #i)
   ∧
    ∀ #j.
     (AuthorizedInboundRequest( server, actor, client, sid, request ) @ #j)
    ⇒
     ¬(#j < #i)) ∨
  (∃ serverB sid payload #i.
    (EventEnqueued( serverB, sid, payload ) @ #i)
   ∧
    ∀ actor #j.
     (AuthorizedInboundEvent( serverB, actor, sid, payload ) @ #j)
    ⇒
     ¬(#j < #i)))"
*/
by sorry

