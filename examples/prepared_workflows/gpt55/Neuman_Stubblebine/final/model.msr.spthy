theory Neuman_Stubblebine

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

restriction equality_checks:
  "∀ x y #i. (CheckEq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

lemma AUTO_typing [sources]:
  all-traces
  "((((((∀ m #i.
          (IN_M1( m ) @ #i) ⇒
          (((∃ #j. (OUT_M1( m ) @ #j) ∧ (#j < #i)) ∨
            (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))) ∨
           (∃ #l. (K( m ) @ #l) ∧ (#l < #i)))) ∧
        (∀ m #i.
          (IN_M2( m ) @ #i) ⇒
          (((∃ #j. (OUT_M2( m ) @ #j) ∧ (#j < #i)) ∨
            (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))) ∨
           (∃ #l. (K( m ) @ #l) ∧ (#l < #i))))) ∧
       (∀ m #i.
         (IN_M3( m ) @ #i) ⇒
         (((∃ #j. (OUT_M3( m ) @ #j) ∧ (#j < #i)) ∨
           (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))) ∨
          (∃ #l. (K( m ) @ #l) ∧ (#l < #i))))) ∧
      (∀ m #i.
        (IN_M4( m ) @ #i) ⇒
        (((∃ #j. (OUT_M4( m ) @ #j) ∧ (#j < #i)) ∨
          (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))) ∨
         (∃ #l. (K( m ) @ #l) ∧ (#l < #i))))) ∧
     (∀ m #i.
       (IN_M5( m ) @ #i) ⇒
       (((∃ #j. (OUT_M5( m ) @ #j) ∧ (#j < #i)) ∨
         (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))) ∨
        (∃ #l. (K( m ) @ #l) ∧ (#l < #i))))) ∧
    (∀ m #i.
      (IN_M6( m ) @ #i) ⇒
      (((∃ #j. (OUT_M6( m ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))) ∨
       (∃ #l. (K( m ) @ #l) ∧ (#l < #i))))) ∧
   (∀ m #i.
     (IN_M7( m ) @ #i) ⇒
     (((∃ #j. (OUT_M7( m ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))) ∨
      (∃ #l. (K( m ) @ #l) ∧ (#l < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m #i.
    (IN_M1( m ) @ #i)
   ∧
    (∀ #j. (OUT_M1( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i)) ∧
    (∀ #l. (K( m ) @ #l) ⇒ ¬(#l < #i))) ∨
  (∃ m #i.
    (IN_M2( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i)) ∧
    (∀ #l. (K( m ) @ #l) ⇒ ¬(#l < #i))) ∨
  (∃ m #i.
    (IN_M3( m ) @ #i)
   ∧
    (∀ #j. (OUT_M3( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i)) ∧
    (∀ #l. (K( m ) @ #l) ⇒ ¬(#l < #i))) ∨
  (∃ m #i.
    (IN_M4( m ) @ #i)
   ∧
    (∀ #j. (OUT_M4( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i)) ∧
    (∀ #l. (K( m ) @ #l) ⇒ ¬(#l < #i))) ∨
  (∃ m #i.
    (IN_M5( m ) @ #i)
   ∧
    (∀ #j. (OUT_M5( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i)) ∧
    (∀ #l. (K( m ) @ #l) ⇒ ¬(#l < #i))) ∨
  (∃ m #i.
    (IN_M6( m ) @ #i)
   ∧
    (∀ #j. (OUT_M6( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i)) ∧
    (∀ #l. (K( m ) @ #l) ⇒ ¬(#l < #i))) ∨
  (∃ m #i.
    (IN_M7( m ) @ #i)
   ∧
    (∀ #j. (OUT_M7( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i)) ∧
    (∀ #l. (K( m ) @ #l) ⇒ ¬(#l < #i))))"
*/
by sorry

lemma executability:
  exists-trace
  "∃ a b s kab na nb tb na2 nb2 ticket #i1 #i2 #i3 #i4 #i5 #i6 #i7 #i8 #i9.
    ((((((((((((((((Start_A( a, b, na ) @ #i1) ∧
                   (Running_B_initial( b, a, na, nb, tb ) @ #i2)) ∧
                  (Server_Issue( s, a, b, kab, na, nb, tb ) @ #i3)) ∧
                 (Commit_A_initial( a, b, kab, na, tb ) @ #i4)) ∧
                (Commit_B_initial( b, a, kab, na, nb, tb ) @ #i5)) ∧
               (Reuse_Start_A( a, b, kab, na2, ticket ) @ #i6)) ∧
              (Reuse_Running_B( b, a, kab, na2, nb2, tb ) @ #i7)) ∧
             (Commit_A_reuse( a, b, kab, na2, nb2 ) @ #i8)) ∧
            (Commit_B_reuse( b, a, kab, na2, nb2, tb ) @ #i9)) ∧
           (#i1 < #i2)) ∧
          (#i2 < #i3)) ∧
         (#i3 < #i4)) ∧
        (#i4 < #i5)) ∧
       (#i5 < #i6)) ∧
      (#i6 < #i7)) ∧
     (#i7 < #i8)) ∧
    (#i8 < #i9)"
/*
guarded formula characterizing all satisfying traces:
"∃ a b s kab na nb tb na2 nb2 ticket #i1 #i2 #i3 #i4 #i5 #i6 #i7 #i8 #i9.
  (Start_A( a, b, na ) @ #i1) ∧
  (Running_B_initial( b, a, na, nb, tb ) @ #i2) ∧
  (Server_Issue( s, a, b, kab, na, nb, tb ) @ #i3) ∧
  (Commit_A_initial( a, b, kab, na, tb ) @ #i4) ∧
  (Commit_B_initial( b, a, kab, na, nb, tb ) @ #i5) ∧
  (Reuse_Start_A( a, b, kab, na2, ticket ) @ #i6) ∧
  (Reuse_Running_B( b, a, kab, na2, nb2, tb ) @ #i7) ∧
  (Commit_A_reuse( a, b, kab, na2, nb2 ) @ #i8) ∧
  (Commit_B_reuse( b, a, kab, na2, nb2, tb ) @ #i9)
 ∧
  (#i1 < #i2) ∧
  (#i2 < #i3) ∧
  (#i3 < #i4) ∧
  (#i4 < #i5) ∧
  (#i5 < #i6) ∧
  (#i6 < #i7) ∧
  (#i7 < #i8) ∧
  (#i8 < #i9)"
*/
by sorry

lemma secrecy:
  all-traces
  "∀ a b kab #i. (Secret( a, b, kab ) @ #i) ⇒ (¬(∃ #j. K( kab ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab #i. (Secret( a, b, kab ) @ #i) ∧ ∃ #j. (K( kab ) @ #j)"
*/
by sorry

lemma noninjectiveagreement_B:
  all-traces
  "∀ b a kab na nb tb #i.
    (Commit_B_initial( b, a, kab, na, nb, tb ) @ #i) ⇒
    (∃ s #j. (Server_Issue( s, a, b, kab, na, nb, tb ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ b a kab na nb tb #i.
  (Commit_B_initial( b, a, kab, na, nb, tb ) @ #i)
 ∧
  ∀ s #j. (Server_Issue( s, a, b, kab, na, nb, tb ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma noninjectiveagreement_A:
  all-traces
  "∀ a b kab na tb #i.
    (Commit_A_initial( a, b, kab, na, tb ) @ #i) ⇒
    (∃ nb srv #rb #ss #cb.
      ((((((Running_B_initial( b, a, na, nb, tb ) @ #rb) ∧
           (Server_Issue( srv, a, b, kab, na, nb, tb ) @ #ss)) ∧
          (Commit_B_initial( b, a, kab, na, nb, tb ) @ #cb)) ∧
         (#rb < #ss)) ∧
        (#ss < #i)) ∧
       (#cb < #i)) ∧
      (∀ #i2. (Commit_A_initial( a, b, kab, na, tb ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab na tb #i.
  (Commit_A_initial( a, b, kab, na, tb ) @ #i)
 ∧
  ∀ nb srv #rb #ss #cb.
   (Running_B_initial( b, a, na, nb, tb ) @ #rb) ∧
   (Server_Issue( srv, a, b, kab, na, nb, tb ) @ #ss) ∧
   (Commit_B_initial( b, a, kab, na, nb, tb ) @ #cb)
  ⇒
   ((¬(#rb < #ss)) ∨
    (¬(#ss < #i)) ∨
    (¬(#cb < #i)) ∨
    (∃ #i2. (Commit_A_initial( a, b, kab, na, tb ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ b a kab na nb tb #i.
    (Commit_B_initial( b, a, kab, na, nb, tb ) @ #i) ⇒
    (∃ s #j.
      (((Server_Issue( s, a, b, kab, na, nb, tb ) @ #j) ∧ (#j < #i)) ∧
       (∀ s2 #k.
         (Server_Issue( s2, a, b, kab, na, nb, tb ) @ #k) ⇒ (#k = #j))) ∧
      (∀ #l. (Commit_B_initial( b, a, kab, na, nb, tb ) @ #l) ⇒ (#l = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ b a kab na nb tb #i.
  (Commit_B_initial( b, a, kab, na, nb, tb ) @ #i)
 ∧
  ∀ s #j.
   (Server_Issue( s, a, b, kab, na, nb, tb ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ s2 #k.
      (Server_Issue( s2, a, b, kab, na, nb, tb ) @ #k) ∧ ¬(#k = #j)) ∨
    (∃ #l. (Commit_B_initial( b, a, kab, na, nb, tb ) @ #l) ∧ ¬(#l = #i)))"
*/
by sorry

lemma injectiveagreement_A:
  all-traces
  "∀ a b kab na tb #i.
    (Commit_A_initial( a, b, kab, na, tb ) @ #i) ⇒
    (∃ nb srv #rb #ss #cb.
      ((((((((Running_B_initial( b, a, na, nb, tb ) @ #rb) ∧
             (Server_Issue( srv, a, b, kab, na, nb, tb ) @ #ss)) ∧
            (Commit_B_initial( b, a, kab, na, nb, tb ) @ #cb)) ∧
           (#rb < #ss)) ∧
          (#ss < #i)) ∧
         (#cb < #i)) ∧
        (∀ nb2 srv2 #rb2 #ss2.
          ((Running_B_initial( b, a, na, nb2, tb ) @ #rb2) ∧
           (Server_Issue( srv2, a, b, kab, na, nb2, tb ) @ #ss2)) ⇒
          ((#rb2 = #rb) ∧ (#ss2 = #ss)))) ∧
       (∀ nb2 #cb2.
         (Commit_B_initial( b, a, kab, na, nb2, tb ) @ #cb2) ⇒ (#cb2 = #cb))) ∧
      (∀ #i2. (Commit_A_initial( a, b, kab, na, tb ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab na tb #i.
  (Commit_A_initial( a, b, kab, na, tb ) @ #i)
 ∧
  ∀ nb srv #rb #ss #cb.
   (Running_B_initial( b, a, na, nb, tb ) @ #rb) ∧
   (Server_Issue( srv, a, b, kab, na, nb, tb ) @ #ss) ∧
   (Commit_B_initial( b, a, kab, na, nb, tb ) @ #cb)
  ⇒
   ((¬(#rb < #ss)) ∨
    (¬(#ss < #i)) ∨
    (¬(#cb < #i)) ∨
    (∃ nb2 srv2 #rb2 #ss2.
      (Running_B_initial( b, a, na, nb2, tb ) @ #rb2) ∧
      (Server_Issue( srv2, a, b, kab, na, nb2, tb ) @ #ss2)
     ∧
      ((¬(#rb2 = #rb)) ∨ (¬(#ss2 = #ss)))) ∨
    (∃ nb2 #cb2.
      (Commit_B_initial( b, a, kab, na, nb2, tb ) @ #cb2) ∧ ¬(#cb2 = #cb)) ∨
    (∃ #i2. (Commit_A_initial( a, b, kab, na, tb ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

