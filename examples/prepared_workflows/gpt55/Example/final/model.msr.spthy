lemma Client_session_key_secrecy:
  all-traces
  "∀ c s k #i. (Secret( c, s, k ) @ #i) ⇒ (¬(∃ #j. K( k ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c s k #i. (Secret( c, s, k ) @ #i) ∧ ∃ #j. (K( k ) @ #j)"
*/
by sorry

lemma Client_auth:
  all-traces
  "∀ c s k #i.
    (Commit( c, s, k ) @ #i) ⇒
    (∃ #j. (ServerConfirm( s, k ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ c s k #i.
  (Commit( c, s, k ) @ #i)
 ∧
  ∀ #j. (ServerConfirm( s, k ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma Client_auth_injective:
  all-traces
  "(∀ c s k #i.
     (Commit( c, s, k ) @ #i) ⇒
     (∃ #j. (ServerConfirm( s, k ) @ #j) ∧ (#j < #i))) ∧
   (∀ c s k #i #i2.
     ((Commit( c, s, k ) @ #i) ∧ (Commit( c, s, k ) @ #i2)) ⇒ (#i = #i2))"
/*
guarded formula characterizing all counter-examples:
"((∃ c s k #i.
    (Commit( c, s, k ) @ #i)
   ∧
    ∀ #j. (ServerConfirm( s, k ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ c s k #i #i2.
    (Commit( c, s, k ) @ #i) ∧ (Commit( c, s, k ) @ #i2) ∧ ¬(#i = #i2)))"
*/
by sorry

lemma Client_session_key_honest_setup:
  exists-trace
  "∃ k #i #j #l #m.
    (((((SessionKeyGenerated( 'C', 'S', k ) @ #i) ∧
        (ServerConfirm( 'S', k ) @ #j)) ∧
       (Commit( 'C', 'S', k ) @ #l)) ∧
      (Secret( 'C', 'S', k ) @ #m)) ∧
     (#i < #j)) ∧
    (#j < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ k #i #j #l #m.
  (SessionKeyGenerated( 'C', 'S', k ) @ #i) ∧
  (ServerConfirm( 'S', k ) @ #j) ∧
  (Commit( 'C', 'S', k ) @ #l) ∧
  (Secret( 'C', 'S', k ) @ #m)
 ∧
  (#i < #j) ∧ (#j < #l)"
*/
by sorry

