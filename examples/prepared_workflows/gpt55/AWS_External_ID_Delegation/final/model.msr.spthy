lemma mallory_can_access_alice_resource_principal_only:
  exists-trace
  "∃ suppliedExternalID job #i #j.
    ((CustomerJob( 'Mallory', 'principal_only', 'AliceRole',
                   suppliedExternalID, job
      ) @ #i) ∧
     (ResourceOperation( 'principal_only', 'Mallory', 'AliceRole', 'Alice',
                         job
      ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ suppliedExternalID job #i #j.
  (CustomerJob( 'Mallory', 'principal_only', 'AliceRole',
                suppliedExternalID, job
   ) @ #i) ∧
  (ResourceOperation( 'principal_only', 'Mallory', 'AliceRole', 'Alice',
                      job
   ) @ #j)
 ∧
  #i < #j"
*/
by sorry

