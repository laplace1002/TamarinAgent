theory AWS_External_ID_Delegation

begin

// Function signature and definition of the equational theory E

functions: assume_role_req/5, auth_job/5, cred_cfg/1, cred_raw/1,
           cred_role/1, extid_for/1, fst/1, owner/1, pair/2, pk/1, protected/1,
           resource_call/5, resource_of/1, sign/2, snd/1, sts_response/4,
           tempcred/3, true/0, trusts_provider/1, verify/3
equations:
    cred_cfg(tempcred(c, r, t)) = c,
    cred_raw(tempcred(c, r, t)) = t,
    cred_role(tempcred(c, r, t)) = r,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

heuristic: p

lemma tenant_isolation_principal_only:
  all-traces
  "∀ originatingCustomer requestedRole resourceOwner job #i.
    (ResourceOperation( 'principal_only', originatingCustomer, requestedRole,
                        resourceOwner, job
     ) @ #i) ⇒
    (originatingCustomer = resourceOwner)"
/*
guarded formula characterizing all counter-examples:
"∃ originatingCustomer requestedRole resourceOwner job #i.
  (ResourceOperation( 'principal_only', originatingCustomer, requestedRole,
                      resourceOwner, job
   ) @ #i)
 ∧
  ¬(originatingCustomer = resourceOwner)"
*/
by sorry

