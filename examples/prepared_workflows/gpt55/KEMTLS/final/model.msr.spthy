theory KEMTLS

begin

// Function signature and definition of the equational theory E

functions: aead_dec/3, aead_enc/3, app_key/1, cert/2, decap/2, fst/1,
           h/1, hkdf/3, kdf/2, kem_ct/2, kem_pk/1, kem_ss/2, mac/2, mac_verify/3,
           pair/2, sdec/2, select_alg/2, senc/2, snd/1, transcript_hash/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma exec:
  exists-trace
  "∃ c s session transcript #i #j.
    (Commit( c, s, session, transcript ) @ #i) ∧
    (ServerFinishedVerified( c, s, transcript ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ c s session transcript #i #j.
  (Commit( c, s, session, transcript ) @ #i) ∧
  (ServerFinishedVerified( c, s, transcript ) @ #j)"
*/
by sorry

lemma execbis:
  exists-trace
  "∃ s c tr_cf tr_sf #i #j.
    ((ClientFinishedVerified( s, c, tr_cf ) @ #i) ∧
     (ServerFinishedSent( s, c, tr_sf ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ s c tr_cf tr_sf #i #j.
  (ClientFinishedVerified( s, c, tr_cf ) @ #i) ∧
  (ServerFinishedSent( s, c, tr_sf ) @ #j)
 ∧
  #i < #j"
*/
by sorry

lemma false_secserv:
  all-traces
  "∀ s c app sats #i #k.
    ((Secret( s, c, sats ) @ #i) ∧
     (ServerApplicationDataSent( s, c, app, sats ) @ #k)) ⇒
    (¬(∃ #j. K( sats ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ s c app sats #i #k.
  (Secret( s, c, sats ) @ #i) ∧
  (ServerApplicationDataSent( s, c, app, sats ) @ #k)
 ∧
  ∃ #j. (K( sats ) @ #j)"
*/
by sorry

lemma auth:
  all-traces
  "∀ c s session transcript #i.
    (Commit( c, s, session, transcript ) @ #i) ⇒
    ((∃ #v. ServerFinishedVerified( c, s, transcript ) @ #v) ∧
     ((∃ #j. (Running( s, c, session, transcript ) @ #j) ∧ (#j < #i)) ∨
      (∃ sk #r. (RevealServerLongTermKEMKey( s, sk ) @ #r) ∧ (#r < #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ c s session transcript #i.
  (Commit( c, s, session, transcript ) @ #i)
 ∧
  ((∀ #v. (ServerFinishedVerified( c, s, transcript ) @ #v) ⇒ ⊥) ∨
   ((∀ #j. (Running( s, c, session, transcript ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ sk #r. (RevealServerLongTermKEMKey( s, sk ) @ #r) ⇒ ¬(#r < #i))))"
*/
by sorry

lemma PFS_client:
  all-traces
  "∀ cats #i #j.
    ((Secret( 'C', 'S', cats ) @ #i) ∧ (K( cats ) @ #j)) ⇒
    (∃ sk #r. (RevealServerLongTermKEMKey( 'S', sk ) @ #r) ∧ (#r < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ cats #i #j.
  (Secret( 'C', 'S', cats ) @ #i) ∧ (K( cats ) @ #j)
 ∧
  ∀ sk #r. (RevealServerLongTermKEMKey( 'S', sk ) @ #r) ⇒ ¬(#r < #i)"
*/
by sorry

