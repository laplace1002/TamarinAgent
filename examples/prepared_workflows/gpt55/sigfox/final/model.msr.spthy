theory Sigfox

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, pair/2, pk/1, sdec/2, senc/2, sign/2,
           snd/1, true/0, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

heuristic: p

lemma executable:
  exists-trace
  "∃ na mess sig #i #j.
    ((A_Send( 'A', 'B', na, mess, sig ) @ #i) ∧
     (B_Accept( 'A', 'B', na, mess ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ na mess sig #i #j.
  (A_Send( 'A', 'B', na, mess, sig ) @ #i) ∧
  (B_Accept( 'A', 'B', na, mess ) @ #j)
 ∧
  #i < #j"
*/
by sorry

lemma secret_A:
  all-traces
  "∀ a b na #i.
    (Secret_A( a, b, na ) @ #i) ⇒
    ((¬(∃ #j. K( na ) @ #j)) ∨ (∃ ltkB #r. Reveal_ltkB( b, ltkB ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ a b na #i.
  (Secret_A( a, b, na ) @ #i)
 ∧
  (∃ #j. (K( na ) @ #j)) ∧ (∀ ltkB #r. (Reveal_ltkB( b, ltkB ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma secret_B:
  all-traces
  "∀ a b na #i.
    (Secret_B( a, b, na ) @ #i) ⇒
    (((¬(∃ #j. K( na ) @ #j)) ∨ (∃ ltkB #r. Reveal_ltkB( b, ltkB ) @ #r)) ∨
     (∃ ltkA #r. Reveal_ltkA( a, ltkA ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ a b na #i.
  (Secret_B( a, b, na ) @ #i)
 ∧
  (∃ #j. (K( na ) @ #j)) ∧
  (∀ ltkB #r. (Reveal_ltkB( b, ltkB ) @ #r) ⇒ ⊥) ∧
  (∀ ltkA #r. (Reveal_ltkA( a, ltkA ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma secrecy_PFS_A:
  all-traces
  "∀ a b na ltkB #i #r.
    (((Secret_A( a, b, na ) @ #i) ∧ (Reveal_ltkB( b, ltkB ) @ #r)) ∧
     (#i < #r)) ⇒
    (¬(∃ #j. K( na ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ a b na ltkB #i #r.
  (Secret_A( a, b, na ) @ #i) ∧ (Reveal_ltkB( b, ltkB ) @ #r)
 ∧
  (#i < #r) ∧ (∃ #j. (K( na ) @ #j))"
*/
by sorry

