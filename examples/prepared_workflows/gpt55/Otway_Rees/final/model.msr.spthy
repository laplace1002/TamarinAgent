theory Otway_Rees

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma Secrecy:
  all-traces
  "∀ a b kab #t. (Secret( a, b, kab ) @ #t) ⇒ (¬(∃ #k. K( kab ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab #t. (Secret( a, b, kab ) @ #t) ∧ ∃ #k. (K( kab ) @ #k)"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ b a s sid nb kab #t.
    (Commit_B( b, a, s, sid, nb, kab ) @ #t) ⇒
    (∃ na #rs #as.
      ((((Running_S( s, a, b, sid, na, nb, kab ) @ #rs) ∧
         (A_Start( a, b, sid, na ) @ #as)) ∧
        (#as < #rs)) ∧
       (#rs < #t)) ∧
      (∀ #t2. (Commit_B( b, a, s, sid, nb, kab ) @ #t2) ⇒ (#t2 = #t)))"
/*
guarded formula characterizing all counter-examples:
"∃ b a s sid nb kab #t.
  (Commit_B( b, a, s, sid, nb, kab ) @ #t)
 ∧
  ∀ na #rs #as.
   (Running_S( s, a, b, sid, na, nb, kab ) @ #rs) ∧
   (A_Start( a, b, sid, na ) @ #as)
  ⇒
   ((¬(#as < #rs)) ∨
    (¬(#rs < #t)) ∨
    (∃ #t2. (Commit_B( b, a, s, sid, nb, kab ) @ #t2) ∧ ¬(#t2 = #t)))"
*/
by sorry

lemma agreement_B:
  all-traces
  "∀ b a s sid nb kab #t.
    (Commit_B( b, a, s, sid, nb, kab ) @ #t) ⇒
    (∃ na #rs #as.
      (((Running_S( s, a, b, sid, na, nb, kab ) @ #rs) ∧
        (A_Start( a, b, sid, na ) @ #as)) ∧
       (#as < #rs)) ∧
      (#rs < #t))"
/*
guarded formula characterizing all counter-examples:
"∃ b a s sid nb kab #t.
  (Commit_B( b, a, s, sid, nb, kab ) @ #t)
 ∧
  ∀ na #rs #as.
   (Running_S( s, a, b, sid, na, nb, kab ) @ #rs) ∧
   (A_Start( a, b, sid, na ) @ #as)
  ⇒
   ((¬(#as < #rs)) ∨ (¬(#rs < #t)))"
*/
by sorry

lemma injectiveagreement_A:
  all-traces
  "∀ a b s sid na kab #t.
    (Commit_A( a, b, s, sid, na, kab ) @ #t) ⇒
    (∃ nb #rs #ba.
      ((((Running_S( s, a, b, sid, na, nb, kab ) @ #rs) ∧
         (B_Accept( b, a, s, sid, nb, kab ) @ #ba)) ∧
        (#rs < #ba)) ∧
       (#ba < #t)) ∧
      (∀ #t2. (Commit_A( a, b, s, sid, na, kab ) @ #t2) ⇒ (#t2 = #t)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b s sid na kab #t.
  (Commit_A( a, b, s, sid, na, kab ) @ #t)
 ∧
  ∀ nb #rs #ba.
   (Running_S( s, a, b, sid, na, nb, kab ) @ #rs) ∧
   (B_Accept( b, a, s, sid, nb, kab ) @ #ba)
  ⇒
   ((¬(#rs < #ba)) ∨
    (¬(#ba < #t)) ∨
    (∃ #t2. (Commit_A( a, b, s, sid, na, kab ) @ #t2) ∧ ¬(#t2 = #t)))"
*/
by sorry

