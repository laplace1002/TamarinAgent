lemma injectiveagreement_S:
  all-traces
  "∀ s a b sid na nb kab #t.
    (Commit_S( s, a, b, sid, na, nb, kab ) @ #t) ⇒
    (∃ #ra #rb.
      ((((Running_A( a, b, sid, na ) @ #ra) ∧
         (Running_B( b, a, s, sid, nb ) @ #rb)) ∧
        (#ra < #t)) ∧
       (#rb < #t)) ∧
      (∀ kab2 #t2.
        (Commit_S( s, a, b, sid, na, nb, kab2 ) @ #t2) ⇒ (#t2 = #t)))"
/*
guarded formula characterizing all counter-examples:
"∃ s a b sid na nb kab #t.
  (Commit_S( s, a, b, sid, na, nb, kab ) @ #t)
 ∧
  ∀ #ra #rb.
   (Running_A( a, b, sid, na ) @ #ra) ∧
   (Running_B( b, a, s, sid, nb ) @ #rb)
  ⇒
   ((¬(#ra < #t)) ∨
    (¬(#rb < #t)) ∨
    (∃ kab2 #t2.
      (Commit_S( s, a, b, sid, na, nb, kab2 ) @ #t2) ∧ ¬(#t2 = #t)))"
*/
by sorry

