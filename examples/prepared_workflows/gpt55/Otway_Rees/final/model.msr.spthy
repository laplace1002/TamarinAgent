lemma executability:
  exists-trace
  "∃ a b s sid na nb kab #i #j #k #l.
    ((((((A_Start( a, b, sid, na ) @ #i) ∧
         (S_Generate( s, a, b, sid, na, nb, kab ) @ #j)) ∧
        (B_Accept( b, a, s, sid, nb, kab ) @ #k)) ∧
       (A_Accept( a, b, s, sid, na, kab ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ a b s sid na nb kab #i #j #k #l.
  (A_Start( a, b, sid, na ) @ #i) ∧
  (S_Generate( s, a, b, sid, na, nb, kab ) @ #j) ∧
  (B_Accept( b, a, s, sid, nb, kab ) @ #k) ∧
  (A_Accept( a, b, s, sid, na, kab ) @ #l)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l)"
*/
by sorry

lemma AUTO_typing [sources]:
  all-traces
  "((((∀ m #i.
        (IN_Message( m ) @ #i) ⇒
        ((∃ #j. (OUT_Message( m ) @ #j) ∧ (#j < #i)) ∨
         (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i)))) ∧
      (∀ m #i.
        (IN_M1( m ) @ #i) ⇒
        ((∃ #j. (OUT_M1( m ) @ #j) ∧ (#j < #i)) ∨
         (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
     (∀ m #i.
       (IN_M2( m ) @ #i) ⇒
       ((∃ #j. (OUT_M2( m ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
    (∀ m #i.
      (IN_M3( m ) @ #i) ⇒
      ((∃ #j. (OUT_M3( m ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
   (∀ m #i.
     (IN_M4( m ) @ #i) ⇒
     ((∃ #j. (OUT_M4( m ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m #i.
    (IN_Message( m ) @ #i)
   ∧
    (∀ #j. (OUT_Message( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M1( m ) @ #i)
   ∧
    (∀ #j. (OUT_M1( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M3( m ) @ #i)
   ∧
    (∀ #j. (OUT_M3( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M4( m ) @ #i)
   ∧
    (∀ #j. (OUT_M4( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))))"
*/
by sorry

