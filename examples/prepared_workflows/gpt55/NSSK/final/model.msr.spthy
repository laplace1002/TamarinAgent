theory NSSK

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, pred/1, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma AUTO_typing [sources]:
  all-traces
  "((((∀ m #i.
        (IN_M1( m ) @ #i) ⇒
        ((∃ #j. (OUT_M1( m ) @ #j) ∧ (#j < #i)) ∨
         (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i)))) ∧
      (∀ m #i.
        (IN_M2( m ) @ #i) ⇒
        ((∃ #j. (OUT_M2( m ) @ #j) ∧ (#j < #i)) ∨
         (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
     (∀ m #i.
       (IN_M3( m ) @ #i) ⇒
       ((∃ #j. (OUT_M3( m ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
    (∀ m #i.
      (IN_M4( m ) @ #i) ⇒
      ((∃ #j. (OUT_M4( m ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
   (∀ m #i.
     (IN_M5( m ) @ #i) ⇒
     ((∃ #j. (OUT_M5( m ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m #i.
    (IN_M1( m ) @ #i)
   ∧
    (∀ #j. (OUT_M1( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M3( m ) @ #i)
   ∧
    (∀ #j. (OUT_M3( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M4( m ) @ #i)
   ∧
    (∀ #j. (OUT_M4( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M5( m ) @ #i)
   ∧
    (∀ #j. (OUT_M5( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))))"
*/
by sorry

lemma executability:
  exists-trace
  "∃ na kab nb #i #j #k #l #m #n.
    ((((((((((Start_A( 'A', 'B', na ) @ #i) ∧
             (S_Issue( 'S', 'A', 'B', na, kab ) @ #j)) ∧
            (Running_A( 'A', 'B', kab, na ) @ #k)) ∧
           (Running_B( 'B', 'A', kab, nb ) @ #l)) ∧
          (Commit_A( 'A', 'B', kab, nb ) @ #m)) ∧
         (Commit_B( 'B', 'A', kab, nb ) @ #n)) ∧
        (#i < #j)) ∧
       (#j < #k)) ∧
      (#k < #l)) ∧
     (#l < #m)) ∧
    (#m < #n)"
/*
guarded formula characterizing all satisfying traces:
"∃ na kab nb #i #j #k #l #m #n.
  (Start_A( 'A', 'B', na ) @ #i) ∧
  (S_Issue( 'S', 'A', 'B', na, kab ) @ #j) ∧
  (Running_A( 'A', 'B', kab, na ) @ #k) ∧
  (Running_B( 'B', 'A', kab, nb ) @ #l) ∧
  (Commit_A( 'A', 'B', kab, nb ) @ #m) ∧
  (Commit_B( 'B', 'A', kab, nb ) @ #n)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l) ∧ (#l < #m) ∧ (#m < #n)"
*/
by sorry

lemma Secrecy:
  all-traces
  "∀ a b kab #i. (Secret( a, b, kab ) @ #i) ⇒ (¬(∃ #j. K( kab ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab #i. (Secret( a, b, kab ) @ #i) ∧ ∃ #j. (K( kab ) @ #j)"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ b a kab nb #i.
    (Commit_B( b, a, kab, nb ) @ #i) ⇒
    ((∃ s na #j #k #l.
       (((((Running_A( a, b, kab, na ) @ #j) ∧
           (Commit_A( a, b, kab, nb ) @ #k)) ∧
          (S_Issue( s, a, b, na, kab ) @ #l)) ∧
         (#l < #j)) ∧
        (#j < #k)) ∧
       (#k < #i)) ∧
     (∀ #i2. (Commit_B( b, a, kab, nb ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ b a kab nb #i.
  (Commit_B( b, a, kab, nb ) @ #i)
 ∧
  ((∀ s na #j #k #l.
     (Running_A( a, b, kab, na ) @ #j) ∧
     (Commit_A( a, b, kab, nb ) @ #k) ∧
     (S_Issue( s, a, b, na, kab ) @ #l)
    ⇒
     ((¬(#l < #j)) ∨ (¬(#j < #k)) ∨ (¬(#k < #i)))) ∨
   (∃ #i2. (Commit_B( b, a, kab, nb ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

lemma agreement_B:
  all-traces
  "∀ b a kab nb #i.
    (Commit_B( b, a, kab, nb ) @ #i) ⇒
    (∃ s na #j #k.
      (((Commit_A( a, b, kab, nb ) @ #j) ∧
        (S_Issue( s, a, b, na, kab ) @ #k)) ∧
       (#k < #i)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ b a kab nb #i.
  (Commit_B( b, a, kab, nb ) @ #i)
 ∧
  ∀ s na #j #k.
   (Commit_A( a, b, kab, nb ) @ #j) ∧ (S_Issue( s, a, b, na, kab ) @ #k)
  ⇒
   ((¬(#k < #i)) ∨ (¬(#j < #i)))"
*/
by sorry

