theory Yahalom

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma AUTO_typing [sources]:
  all-traces
  "(((∀ m #i.
       (IN_M1( m ) @ #i) ⇒
       ((∃ #j. (OUT_M1( m ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i)))) ∧
     (∀ m #i.
       (IN_M2( m ) @ #i) ⇒
       ((∃ #j. (OUT_M2( m ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
    (∀ m #i.
      (IN_M3( m ) @ #i) ⇒
      ((∃ #j. (OUT_M3( m ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
   (∀ m #i.
     (IN_M4( m ) @ #i) ⇒
     ((∃ #j. (OUT_M4( m ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m #i.
    (IN_M1( m ) @ #i)
   ∧
    (∀ #j. (OUT_M1( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M3( m ) @ #i)
   ∧
    (∀ #j. (OUT_M3( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M4( m ) @ #i)
   ∧
    (∀ #j. (OUT_M4( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))))"
*/
by sorry

lemma executability:
  exists-trace
  "∃ a b na nb kab #i #j #k #l #m.
    ((((((((A_Begin( a, b, na ) @ #i) ∧ (B_Running( b, a, na, nb ) @ #j)) ∧
          (S_Issue( a, b, kab, na, nb ) @ #k)) ∧
         (A_Commit( a, b, kab, na, nb ) @ #l)) ∧
        (B_Commit( b, a, kab, na, nb ) @ #m)) ∧
       (#i < #j)) ∧
      (#j < #k)) ∧
     (#k < #l)) ∧
    (#l < #m)"
/*
guarded formula characterizing all satisfying traces:
"∃ a b na nb kab #i #j #k #l #m.
  (A_Begin( a, b, na ) @ #i) ∧
  (B_Running( b, a, na, nb ) @ #j) ∧
  (S_Issue( a, b, kab, na, nb ) @ #k) ∧
  (A_Commit( a, b, kab, na, nb ) @ #l) ∧
  (B_Commit( b, a, kab, na, nb ) @ #m)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l) ∧ (#l < #m)"
*/
by sorry

lemma secrecy:
  all-traces
  "∀ a b kab #i. (Secret( a, b, kab ) @ #i) ⇒ (¬(∃ #j. K( kab ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab #i. (Secret( a, b, kab ) @ #i) ∧ ∃ #j. (K( kab ) @ #j)"
*/
by sorry

lemma noninjectiveagreement_B:
  all-traces
  "∀ a b kab na nb #i.
    (B_Commit( b, a, kab, na, nb ) @ #i) ⇒
    (∃ #j #k.
      (((A_Commit( a, b, kab, na, nb ) @ #j) ∧
        (S_Issue( a, b, kab, na, nb ) @ #k)) ∧
       (#k < #j)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab na nb #i.
  (B_Commit( b, a, kab, na, nb ) @ #i)
 ∧
  ∀ #j #k.
   (A_Commit( a, b, kab, na, nb ) @ #j) ∧
   (S_Issue( a, b, kab, na, nb ) @ #k)
  ⇒
   ((¬(#k < #j)) ∨ (¬(#j < #i)))"
*/
by sorry

lemma noninjectiveagreement_A:
  all-traces
  "∀ a b kab na nb #i.
    (A_Commit( a, b, kab, na, nb ) @ #i) ⇒
    (∃ #j #k.
      (((B_Running( b, a, na, nb ) @ #j) ∧
        (S_Issue( a, b, kab, na, nb ) @ #k)) ∧
       (#j < #k)) ∧
      (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab na nb #i.
  (A_Commit( a, b, kab, na, nb ) @ #i)
 ∧
  ∀ #j #k.
   (B_Running( b, a, na, nb ) @ #j) ∧ (S_Issue( a, b, kab, na, nb ) @ #k)
  ⇒
   ((¬(#j < #k)) ∨ (¬(#k < #i)))"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ a b kab na nb #i.
    (B_Commit( b, a, kab, na, nb ) @ #i) ⇒
    (∃ #j #k.
      (((((A_Commit( a, b, kab, na, nb ) @ #j) ∧
          (S_Issue( a, b, kab, na, nb ) @ #k)) ∧
         (#k < #j)) ∧
        (#j < #i)) ∧
       (∀ #j2. (A_Commit( a, b, kab, na, nb ) @ #j2) ⇒ (#j2 = #j))) ∧
      (∀ #k2. (S_Issue( a, b, kab, na, nb ) @ #k2) ⇒ (#k2 = #k)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab na nb #i.
  (B_Commit( b, a, kab, na, nb ) @ #i)
 ∧
  ∀ #j #k.
   (A_Commit( a, b, kab, na, nb ) @ #j) ∧
   (S_Issue( a, b, kab, na, nb ) @ #k)
  ⇒
   ((¬(#k < #j)) ∨
    (¬(#j < #i)) ∨
    (∃ #j2. (A_Commit( a, b, kab, na, nb ) @ #j2) ∧ ¬(#j2 = #j)) ∨
    (∃ #k2. (S_Issue( a, b, kab, na, nb ) @ #k2) ∧ ¬(#k2 = #k)))"
*/
by sorry

