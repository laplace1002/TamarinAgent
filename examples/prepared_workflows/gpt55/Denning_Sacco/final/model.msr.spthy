theory Denning_Sacco

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma AUTO_typing [sources]:
  all-traces
  "((∀ m #i.
      (IN_M1( m ) @ #i) ⇒
      ((∃ #j. (OUT_M1( m ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i)))) ∧
    (∀ m #i.
      (IN_M2( m ) @ #i) ⇒
      ((∃ #j. (OUT_M2( m ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
   (∀ m #i.
     (IN_M3( m ) @ #i) ⇒
     ((∃ #j. (OUT_M3( m ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m #i.
    (IN_M1( m ) @ #i)
   ∧
    (∀ #j. (OUT_M1( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M3( m ) @ #i)
   ∧
    (∀ #j. (OUT_M3( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))))"
*/
by sorry

lemma executability:
  exists-trace
  "∃ kab t #i #j #k #l.
    ((((((Request_A( 'A', 'B' ) @ #i) ∧
         (ServerIssue( 'S', 'A', 'B', kab, t ) @ #j)) ∧
        (Running_A( 'A', 'B', kab, t ) @ #k)) ∧
       (Commit_B( 'B', 'A', kab, t ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ kab t #i #j #k #l.
  (Request_A( 'A', 'B' ) @ #i) ∧
  (ServerIssue( 'S', 'A', 'B', kab, t ) @ #j) ∧
  (Running_A( 'A', 'B', kab, t ) @ #k) ∧
  (Commit_B( 'B', 'A', kab, t ) @ #l)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l)"
*/
by sorry

lemma secrecy:
  all-traces
  "¬(∃ a b kab #i #j. (Secret( a, b, kab ) @ #i) ∧ (K( kab ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ a b kab #i #j. (Secret( a, b, kab ) @ #i) ∧ (K( kab ) @ #j)"
*/
by sorry

lemma noninjectiveagreement_B:
  all-traces
  "∀ kab t #i.
    (Commit_B( 'B', 'A', kab, t ) @ #i) ⇒
    (∃ #j #k.
      (((Running_A( 'A', 'B', kab, t ) @ #j) ∧
        (ServerIssue( 'S', 'A', 'B', kab, t ) @ #k)) ∧
       (#k < #j)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ kab t #i.
  (Commit_B( 'B', 'A', kab, t ) @ #i)
 ∧
  ∀ #j #k.
   (Running_A( 'A', 'B', kab, t ) @ #j) ∧
   (ServerIssue( 'S', 'A', 'B', kab, t ) @ #k)
  ⇒
   ((¬(#k < #j)) ∨ (¬(#j < #i)))"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ kab t #i.
    (Commit_B( 'B', 'A', kab, t ) @ #i) ⇒
    (∃ ticket #j #k.
      ((((A_Forward( 'A', 'B', kab, t, ticket ) @ #j) ∧
         (ServerIssue( 'S', 'A', 'B', kab, t ) @ #k)) ∧
        (#k < #j)) ∧
       (#j < #i)) ∧
      (∀ #i2. (Commit_B( 'B', 'A', kab, t ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ kab t #i.
  (Commit_B( 'B', 'A', kab, t ) @ #i)
 ∧
  ∀ ticket #j #k.
   (A_Forward( 'A', 'B', kab, t, ticket ) @ #j) ∧
   (ServerIssue( 'S', 'A', 'B', kab, t ) @ #k)
  ⇒
   ((¬(#k < #j)) ∨
    (¬(#j < #i)) ∨
    (∃ #i2. (Commit_B( 'B', 'A', kab, t ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

