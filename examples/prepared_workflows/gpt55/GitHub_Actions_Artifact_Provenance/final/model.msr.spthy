theory GitHub_Actions_Artifact_Provenance

begin

// Function signature and definition of the equational theory E

functions: auth_artifact/8, auth_notify/6, cred_id/1, cred_submit/10,
           fst/1, pair/2, pk/1, run_record/9, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

heuristic: p

lemma name_only_fork_artifact_privileged_use_reachable:
  exists-trace
  "∃ artifact_id producing_run body commit trigger_run #i #j.
    ((ArtifactStored( artifact_id, producing_run, 'package', body,
                      'fork_repo', 'fork_branch', commit
      ) @ #i) ∧
     (PrivilegedUse( 'name_only', trigger_run, artifact_id, producing_run,
                     'fork_repo', 'fork_branch', commit, body
      ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ artifact_id producing_run body commit trigger_run #i #j.
  (ArtifactStored( artifact_id, producing_run, 'package', body,
                   'fork_repo', 'fork_branch', commit
   ) @ #i) ∧
  (PrivilegedUse( 'name_only', trigger_run, artifact_id, producing_run,
                  'fork_repo', 'fork_branch', commit, body
   ) @ #j)
 ∧
  #i < #j"
*/
by sorry

lemma run_bound_fork_artifact_privileged_use_reachable:
  exists-trace
  "∃ trigger_run artifact_id commit body #i #j.
    ((RunComplete( trigger_run, 'fork_repo', 'fork_branch', commit,
                   'build_workflow', 'success'
      ) @ #i) ∧
     (PrivilegedUse( 'run_bound', trigger_run, artifact_id, trigger_run,
                     'fork_repo', 'fork_branch', commit, body
      ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ trigger_run artifact_id commit body #i #j.
  (RunComplete( trigger_run, 'fork_repo', 'fork_branch', commit,
                'build_workflow', 'success'
   ) @ #i) ∧
  (PrivilegedUse( 'run_bound', trigger_run, artifact_id, trigger_run,
                  'fork_repo', 'fork_branch', commit, body
   ) @ #j)
 ∧
  #i < #j"
*/
by sorry

lemma name_only_all_privileged_uses_are_trusted_origin:
  all-traces
  "∀ trigger_run artifact_id producing_run repo branch commit body #i.
    (PrivilegedUse( 'name_only', trigger_run, artifact_id, producing_run,
                    repo, branch, commit, body
     ) @ #i) ⇒
    ((repo = 'protected_repo') ∧ (branch = 'protected_branch'))"
/*
guarded formula characterizing all counter-examples:
"∃ trigger_run artifact_id producing_run repo branch commit body #i.
  (PrivilegedUse( 'name_only', trigger_run, artifact_id, producing_run,
                  repo, branch, commit, body
   ) @ #i)
 ∧
  ((¬(repo = 'protected_repo')) ∨ (¬(branch = 'protected_branch')))"
*/
by sorry

