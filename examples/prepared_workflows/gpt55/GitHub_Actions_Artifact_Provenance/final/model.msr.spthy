lemma legitimate_protected_branch_deployment_executable_all_configs:
  exists-trace
  "∃ trigger_run1 artifact_id1 producing_run1 commit1 body1 trigger_run2
     artifact_id2 commit2 body2 trigger_run3 artifact_id3 commit3 body3 #i #j
     #k.
    ((PrivilegedUse( 'name_only', trigger_run1, artifact_id1, producing_run1,
                     'protected_repo', 'protected_branch', commit1, body1
      ) @ #i) ∧
     (PrivilegedUse( 'run_bound', trigger_run2, artifact_id2, trigger_run2,
                     'protected_repo', 'protected_branch', commit2, body2
      ) @ #j)) ∧
    (PrivilegedUse( 'trusted_origin', trigger_run3, artifact_id3,
                    trigger_run3, 'protected_repo', 'protected_branch', commit3, body3
     ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ trigger_run1 artifact_id1 producing_run1 commit1 body1 trigger_run2
   artifact_id2 commit2 body2 trigger_run3 artifact_id3 commit3 body3 #i #j
   #k.
  (PrivilegedUse( 'name_only', trigger_run1, artifact_id1, producing_run1,
                  'protected_repo', 'protected_branch', commit1, body1
   ) @ #i) ∧
  (PrivilegedUse( 'run_bound', trigger_run2, artifact_id2, trigger_run2,
                  'protected_repo', 'protected_branch', commit2, body2
   ) @ #j) ∧
  (PrivilegedUse( 'trusted_origin', trigger_run3, artifact_id3,
                  trigger_run3, 'protected_repo', 'protected_branch', commit3, body3
   ) @ #k)"
*/
by sorry

