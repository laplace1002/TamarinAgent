lemma name_only_selected_artifact_belongs_to_triggering_run:
  all-traces
  "∀ trigger_run artifact_id producing_run name body repo branch commit #i.
    (ArtifactSelected( 'name_only', trigger_run, artifact_id, producing_run,
                       name, body, repo, branch, commit
     ) @ #i) ⇒
    (producing_run = trigger_run)"
/*
guarded formula characterizing all counter-examples:
"∃ trigger_run artifact_id producing_run name body repo branch commit #i.
  (ArtifactSelected( 'name_only', trigger_run, artifact_id, producing_run,
                     name, body, repo, branch, commit
   ) @ #i)
 ∧
  ¬(producing_run = trigger_run)"
*/
by sorry

