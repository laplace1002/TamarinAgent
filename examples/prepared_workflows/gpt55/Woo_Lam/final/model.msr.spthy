theory Woo_Lam

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma AUTO_typing [sources]:
  all-traces
  "((((∀ m #i.
        (IN_Message( <'M1', m> ) @ #i) ⇒
        ((∃ #j. (OUT_Message( <'M1', m> ) @ #j) ∧ (#j < #i)) ∨
         (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i)))) ∧
      (∀ m #i.
        (IN_Message( <'M2', m> ) @ #i) ⇒
        ((∃ #j. (OUT_Message( <'M2', m> ) @ #j) ∧ (#j < #i)) ∨
         (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
     (∀ m #i.
       (IN_Message( <'M3', m> ) @ #i) ⇒
       ((∃ #j. (OUT_Message( <'M3', m> ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
    (∀ m #i.
      (IN_Message( <'M4', m> ) @ #i) ⇒
      ((∃ #j. (OUT_Message( <'M4', m> ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
   (∀ m #i.
     (IN_Message( <'M5', m> ) @ #i) ⇒
     ((∃ #j. (OUT_Message( <'M5', m> ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m #i.
    (IN_Message( <'M1', m> ) @ #i)
   ∧
    (∀ #j. (OUT_Message( <'M1', m> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_Message( <'M2', m> ) @ #i)
   ∧
    (∀ #j. (OUT_Message( <'M2', m> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_Message( <'M3', m> ) @ #i)
   ∧
    (∀ #j. (OUT_Message( <'M3', m> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_Message( <'M4', m> ) @ #i)
   ∧
    (∀ #j. (OUT_Message( <'M4', m> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_Message( <'M5', m> ) @ #i)
   ∧
    (∀ #j. (OUT_Message( <'M5', m> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))))"
*/
by sorry

lemma executability:
  exists-trace "∃ nb #i. Accept_B( 'B', 'A', nb ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ nb #i. (Accept_B( 'B', 'A', nb ) @ #i)"
*/
by sorry

lemma Secrecy:
  all-traces
  "∀ p q k #i #j. ((SecretKey( p, q, k ) @ #i) ∧ (K( k ) @ #j)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ p q k #i #j. (SecretKey( p, q, k ) @ #i) ∧ (K( k ) @ #j)"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ b a nb #i.
    (Commit_B( b, a, nb ) @ #i) ⇒
    (∃ #j.
      ((Running_A( a, b, nb ) @ #j) ∧ (#j < #i)) ∧
      (∀ #j2. (Running_A( a, b, nb ) @ #j2) ⇒ (#j2 = #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ b a nb #i.
  (Commit_B( b, a, nb ) @ #i)
 ∧
  ∀ #j.
   (Running_A( a, b, nb ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨ (∃ #j2. (Running_A( a, b, nb ) @ #j2) ∧ ¬(#j2 = #j)))"
*/
by sorry

lemma agreement_B:
  all-traces
  "∀ b a nb #i.
    (Commit_B( b, a, nb ) @ #i) ⇒
    (∃ #j. (Running_A( a, b, nb ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ b a nb #i.
  (Commit_B( b, a, nb ) @ #i)
 ∧
  ∀ #j. (Running_A( a, b, nb ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

