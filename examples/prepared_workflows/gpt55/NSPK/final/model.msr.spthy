theory NSPK

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, pair/2, pk/1, snd/1
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma AUTO_typing [sources]:
  all-traces
  "((∀ M #i.
      (IN_M1( M ) @ #i) ⇒
      ((∃ #j. (OUT_M1( M ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( M ) @ #k) ∧ (#k < #i)))) ∧
    (∀ M #i.
      (IN_M2( M ) @ #i) ⇒
      ((∃ #j. (OUT_M2( M ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( M ) @ #k) ∧ (#k < #i))))) ∧
   (∀ M #i.
     (IN_M3( M ) @ #i) ⇒
     ((∃ #j. (OUT_M3( M ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (!KU( M ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ M #i.
    (IN_M1( M ) @ #i)
   ∧
    (∀ #j. (OUT_M1( M ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( M ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ M #i.
    (IN_M2( M ) @ #i)
   ∧
    (∀ #j. (OUT_M2( M ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( M ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ M #i.
    (IN_M3( M ) @ #i)
   ∧
    (∀ #j. (OUT_M3( M ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( M ) @ #k) ⇒ ¬(#k < #i))))"
*/
by sorry

lemma nonce_secrecy:
  all-traces
  "∀ Actor Peer N #i.
    (Secret( Actor, Peer, N ) @ #i) ⇒ (¬(∃ #j. K( N ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ Actor Peer N #i.
  (Secret( Actor, Peer, N ) @ #i) ∧ ∃ #j. (K( N ) @ #j)"
*/
by sorry

lemma injective_agree:
  all-traces
  "∀ Resp Init Na Nb #i.
    (Commit_B( Resp, Init, Na, Nb ) @ #i) ⇒
    ((((∃ #j. (Commit_A( Init, Resp, Na, Nb ) @ #j) ∧ (#j < #i)) ∧
       (∃ #k. (Running_B( Resp, Init, Na, Nb ) @ #k) ∧ (#k < #i))) ∧
      (∃ #l. (Start_A( Init, Resp, Na ) @ #l) ∧ (#l < #i))) ∧
     (∀ #i2. (Commit_B( Resp, Init, Na, Nb ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ Resp Init Na Nb #i.
  (Commit_B( Resp, Init, Na, Nb ) @ #i)
 ∧
  ((∀ #j. (Commit_A( Init, Resp, Na, Nb ) @ #j) ⇒ ¬(#j < #i)) ∨
   (∀ #k. (Running_B( Resp, Init, Na, Nb ) @ #k) ⇒ ¬(#k < #i)) ∨
   (∀ #l. (Start_A( Init, Resp, Na ) @ #l) ⇒ ¬(#l < #i)) ∨
   (∃ #i2. (Commit_B( Resp, Init, Na, Nb ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

lemma session_key_setup_possible:
  exists-trace
  "∃ Init Resp Na Nb #i #j.
    ((Commit_A( Init, Resp, Na, Nb ) @ #i) ∧
     (Commit_B( Resp, Init, Na, Nb ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ Init Resp Na Nb #i #j.
  (Commit_A( Init, Resp, Na, Nb ) @ #i) ∧
  (Commit_B( Resp, Init, Na, Nb ) @ #j)
 ∧
  #i < #j"
*/
by sorry

