theory SPLICE

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, pair/2, pk/1, plus1/1, privenc/2,
           pubdec/2, sign/2, snd/1, true/0, valid_lifetime/2, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    pubdec(privenc(m, sk), pk(sk)) = m,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

heuristic: p

lemma executability:
  exists-trace
  "∃ C S id ts life #i #j #k #l.
    ((((((C_RequestServerKey( C, S, id ) @ #i) ∧
         (C_SendAuthenticator( C, S, id, ts, life ) @ #j)) ∧
        (S_AcceptsClient( S, C, id, ts, life ) @ #k)) ∧
       (C_AcceptsServer( C, S, id ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ C S id ts life #i #j #k #l.
  (C_RequestServerKey( C, S, id ) @ #i) ∧
  (C_SendAuthenticator( C, S, id, ts, life ) @ #j) ∧
  (S_AcceptsClient( S, C, id, ts, life ) @ #k) ∧
  (C_AcceptsServer( C, S, id ) @ #l)
 ∧
  (#i < #j) ∧ (#j < #k) ∧ (#k < #l)"
*/
by sorry

lemma Secrecy:
  all-traces
  "¬(∃ C S id #i #j. (Secret( C, S, id ) @ #i) ∧ (K( id ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ C S id #i #j. (Secret( C, S, id ) @ #i) ∧ (K( id ) @ #j)"
*/
by sorry

lemma injectiveagreement_B:
  all-traces
  "∀ S C id #i.
    (Commit_B( S, C, id ) @ #i) ⇒
    ((∃ #j. (Running_A( C, S, id ) @ #j) ∧ (#j < #i)) ∧
     (∀ #i2. (Commit_B( S, C, id ) @ #i2) ⇒ (#i2 = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ S C id #i.
  (Commit_B( S, C, id ) @ #i)
 ∧
  ((∀ #j. (Running_A( C, S, id ) @ #j) ⇒ ¬(#j < #i)) ∨
   (∃ #i2. (Commit_B( S, C, id ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
by sorry

lemma agreement_B:
  all-traces
  "∀ S C id #i.
    (Commit_B( S, C, id ) @ #i) ⇒
    (∃ #j. (Running_A( C, S, id ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ S C id #i.
  (Commit_B( S, C, id ) @ #i)
 ∧
  ∀ #j. (Running_A( C, S, id ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

