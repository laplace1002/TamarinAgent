lemma AUTO_typing [sources]:
  all-traces
  "(((((∀ m #i.
         (IN_M2a_C_AS_ServerKeyRequest( m ) @ #i) ⇒
         ((∃ #j. (OUT_M2a_C_AS_ServerKeyRequest( m ) @ #j) ∧ (#j < #i)) ∨
          (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i)))) ∧
       (∀ m #i.
         (IN_M2b_AS_C_ServerKeyReply( m ) @ #i) ⇒
         ((∃ #j. (OUT_M2b_AS_C_ServerKeyReply( m ) @ #j) ∧ (#j < #i)) ∨
          (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
      (∀ m #i.
        (IN_M2c_C_S_Authenticator( m ) @ #i) ⇒
        ((∃ #j. (OUT_M2c_C_S_Authenticator( m ) @ #j) ∧ (#j < #i)) ∨
         (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
     (∀ m #i.
       (IN_M2d_S_AS_ClientKeyRequest( m ) @ #i) ⇒
       ((∃ #j. (OUT_M2d_S_AS_ClientKeyRequest( m ) @ #j) ∧ (#j < #i)) ∨
        (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
    (∀ m #i.
      (IN_M2e_AS_S_ClientKeyReply( m ) @ #i) ⇒
      ((∃ #j. (OUT_M2e_AS_S_ClientKeyReply( m ) @ #j) ∧ (#j < #i)) ∨
       (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))) ∧
   (∀ m #i.
     (IN_M2f_S_C_ReturnIdPlusOne( m ) @ #i) ⇒
     ((∃ #j. (OUT_M2f_S_C_ReturnIdPlusOne( m ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (!KU( m ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m #i.
    (IN_M2a_C_AS_ServerKeyRequest( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2a_C_AS_ServerKeyRequest( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2b_AS_C_ServerKeyReply( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2b_AS_C_ServerKeyReply( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2c_C_S_Authenticator( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2c_C_S_Authenticator( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2d_S_AS_ClientKeyRequest( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2d_S_AS_ClientKeyRequest( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2e_AS_S_ClientKeyReply( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2e_AS_S_ClientKeyReply( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))) ∨
  (∃ m #i.
    (IN_M2f_S_C_ReturnIdPlusOne( m ) @ #i)
   ∧
    (∀ #j. (OUT_M2f_S_C_ReturnIdPlusOne( m ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #k. (!KU( m ) @ #k) ⇒ ¬(#k < #i))))"
*/
by sorry

