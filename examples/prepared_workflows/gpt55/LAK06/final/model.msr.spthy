theory LAK06

begin

// Function signature and definition of the equational theory E

builtins: xor
functions: fst/1, h/1, key/1, pair/2, rval/1, snd/1, sval/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma executable:
  exists-trace
  "∃ reader tag backend s r1 r2 r3 k #i #j #l #m #n.
    ((((((((Start_READER( reader, tag, s ) @ #i) ∧
           (Running_TAG( tag, reader, s, r1, r2, k ) @ #j)) ∧
          (DB_Found( backend, tag, k, s, r1, r2 ) @ #l)) ∧
         (Running_READER( reader, tag, s, r1, r2, r3, k ) @ #m)) ∧
        (Commit_TAG( tag, reader, s, r1, r2, r3, k ) @ #n)) ∧
       (#i < #j)) ∧
      (#j < #l)) ∧
     (#l < #m)) ∧
    (#m < #n)"
/*
guarded formula characterizing all satisfying traces:
"∃ reader tag backend s r1 r2 r3 k #i #j #l #m #n.
  (Start_READER( reader, tag, s ) @ #i) ∧
  (Running_TAG( tag, reader, s, r1, r2, k ) @ #j) ∧
  (DB_Found( backend, tag, k, s, r1, r2 ) @ #l) ∧
  (Running_READER( reader, tag, s, r1, r2, r3, k ) @ #m) ∧
  (Commit_TAG( tag, reader, s, r1, r2, r3, k ) @ #n)
 ∧
  (#i < #j) ∧ (#j < #l) ∧ (#l < #m) ∧ (#m < #n)"
*/
by sorry

lemma helpingSecrecy:
  all-traces
  "∀ tag backend k #i.
    (Secret( tag, backend, k ) @ #i) ⇒ (¬(∃ #j. K( k ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ tag backend k #i.
  (Secret( tag, backend, k ) @ #i) ∧ ∃ #j. (K( k ) @ #j)"
*/
by sorry

lemma noninjectiveagreementTAG:
  all-traces
  "∀ tag reader s r1 r2 r3 k #i.
    (Commit_TAG( tag, reader, s, r1, r2, r3, k ) @ #i) ⇒
    (∃ #j.
      (Running_READER( reader, tag, s, r1, r2, r3, k ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ tag reader s r1 r2 r3 k #i.
  (Commit_TAG( tag, reader, s, r1, r2, r3, k ) @ #i)
 ∧
  ∀ #j.
   (Running_READER( reader, tag, s, r1, r2, r3, k ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma noninjectiveagreementREADER:
  all-traces
  "∀ reader tag s r1 r2 r3 k #i.
    (Commit_READER( reader, tag, s, r1, r2, r3, k ) @ #i) ⇒
    (∃ #j. (Running_TAG( tag, reader, s, r1, r2, k ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ reader tag s r1 r2 r3 k #i.
  (Commit_READER( reader, tag, s, r1, r2, r3, k ) @ #i)
 ∧
  ∀ #j. (Running_TAG( tag, reader, s, r1, r2, k ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

