theory EDHOC

begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: aead_enc/4, aead_tag/4, corr/1, cose_encrypt0_aad/4,
           cose_sign1_msg/5, edhoc_error/2, edhoc_kdf/4, fst/1, h/1, kid_or_id/1,
           len/1, omit_if/3, optional/1, pair/2, pk/1, prk_2e/2, prk_3e2m/4,
           prk_4x3m/4, selected_suite/1, sign/2, snd/1, true/0, verify/3, xor_box/2
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

heuristic: p

lemma secretR:
  all-traces
  "∀ r i prk th #t.
    (R_Secret( r, i, prk, th ) @ #t) ⇒ (¬(∃ #j. K( prk ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ r i prk th #t.
  (R_Secret( r, i, prk, th ) @ #t) ∧ ∃ #j. (K( prk ) @ #j)"
*/
by sorry

lemma secretI:
  all-traces
  "∀ i r prk th #t.
    (I_Secret( i, r, prk, th ) @ #t) ⇒ (¬(∃ #j. K( prk ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ i r prk th #t.
  (I_Secret( i, r, prk, th ) @ #t) ∧ ∃ #j. (K( prk ) @ #j)"
*/
by sorry

lemma executableR:
  exists-trace "∃ r i prk th #t. R_ExplicitCommit_RI( r, i, prk, th ) @ #t"
/*
guarded formula characterizing all satisfying traces:
"∃ r i prk th #t. (R_ExplicitCommit_RI( r, i, prk, th ) @ #t)"
*/
by sorry

lemma executableI:
  exists-trace "∃ i r prk th #t. I_ImplicitCommit_IR( i, r, prk, th ) @ #t"
/*
guarded formula characterizing all satisfying traces:
"∃ i r prk th #t. (I_ImplicitCommit_IR( i, r, prk, th ) @ #t)"
*/
by sorry

lemma executableIhonnest:
  exists-trace
  "∃ i r prk th #t #hi #hr.
    ((I_ImplicitCommit_IR( i, r, prk, th ) @ #t) ∧ (Honest( i ) @ #hi)) ∧
    (Honest( r ) @ #hr)"
/*
guarded formula characterizing all satisfying traces:
"∃ i r prk th #t #hi #hr.
  (I_ImplicitCommit_IR( i, r, prk, th ) @ #t) ∧
  (Honest( i ) @ #hi) ∧
  (Honest( r ) @ #hr)"
*/
by sorry

lemma executableRhonnest:
  exists-trace
  "∃ r i prk th #t #hi #hr.
    ((R_ExplicitCommit_RI( r, i, prk, th ) @ #t) ∧ (Honest( i ) @ #hi)) ∧
    (Honest( r ) @ #hr)"
/*
guarded formula characterizing all satisfying traces:
"∃ r i prk th #t #hi #hr.
  (R_ExplicitCommit_RI( r, i, prk, th ) @ #t) ∧
  (Honest( i ) @ #hi) ∧
  (Honest( r ) @ #hr)"
*/
by sorry

lemma false_dishonnestnoauthRI:
  all-traces
  "∀ r i prk th #t.
    (R_ExplicitCommit_RI( r, i, prk, th ) @ #t) ⇒
    (∃ #j. (I_ImplicitCommit_IR( i, r, prk, th ) @ #j) ∧ (#j < #t))"
/*
guarded formula characterizing all counter-examples:
"∃ r i prk th #t.
  (R_ExplicitCommit_RI( r, i, prk, th ) @ #t)
 ∧
  ∀ #j. (I_ImplicitCommit_IR( i, r, prk, th ) @ #j) ⇒ ¬(#j < #t)"
*/
by sorry

lemma false_dishonnestnoauthIR:
  all-traces
  "∀ i r prk th #t.
    (I_ImplicitCommit_IR( i, r, prk, th ) @ #t) ⇒
    (∃ th2 gx gy ci cr suite #j.
      (R_Accept_M1( r, 'unknown_peer', th2, gx, gy, ci, cr, suite ) @ #j) ∧
      (#j < #t))"
/*
guarded formula characterizing all counter-examples:
"∃ i r prk th #t.
  (I_ImplicitCommit_IR( i, r, prk, th ) @ #t)
 ∧
  ∀ th2 gx gy ci cr suite #j.
   (R_Accept_M1( r, 'unknown_peer', th2, gx, gy, ci, cr, suite ) @ #j)
  ⇒
   ¬(#j < #t)"
*/
by sorry

lemma honnestauthRI:
  all-traces
  "∀ r i prk th #t #hi #hr.
    (((R_ExplicitCommit_RI( r, i, prk, th ) @ #t) ∧ (Honest( i ) @ #hi)) ∧
     (Honest( r ) @ #hr)) ⇒
    (∃ #j. (I_ImplicitCommit_IR( i, r, prk, th ) @ #j) ∧ (#j < #t))"
/*
guarded formula characterizing all counter-examples:
"∃ r i prk th #t #hi #hr.
  (R_ExplicitCommit_RI( r, i, prk, th ) @ #t) ∧
  (Honest( i ) @ #hi) ∧
  (Honest( r ) @ #hr)
 ∧
  ∀ #j. (I_ImplicitCommit_IR( i, r, prk, th ) @ #j) ⇒ ¬(#j < #t)"
*/
by sorry

lemma honnestauthIR:
  all-traces
  "∀ i r prk th #t #hi #hr.
    (((I_ImplicitCommit_IR( i, r, prk, th ) @ #t) ∧ (Honest( i ) @ #hi)) ∧
     (Honest( r ) @ #hr)) ⇒
    (∃ th2 gx gy ci cr suite #j.
      (R_Accept_M1( r, 'unknown_peer', th2, gx, gy, ci, cr, suite ) @ #j) ∧
      (#j < #t))"
/*
guarded formula characterizing all counter-examples:
"∃ i r prk th #t #hi #hr.
  (I_ImplicitCommit_IR( i, r, prk, th ) @ #t) ∧
  (Honest( i ) @ #hi) ∧
  (Honest( r ) @ #hr)
 ∧
  ∀ th2 gx gy ci cr suite #j.
   (R_Accept_M1( r, 'unknown_peer', th2, gx, gy, ci, cr, suite ) @ #j)
  ⇒
   ¬(#j < #t)"
*/
by sorry

rule (modulo E) Init[color=#ffffff, process="new ltkI_sig.1;",
                     issapicrule, role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

