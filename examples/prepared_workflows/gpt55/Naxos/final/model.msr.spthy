theory Naxos

begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: fst/1, h/1, h1/2, h2/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma exists_session:
  exists-trace
  "∃ k x y #s #sr #si #r #i.
    ((((((InitSend( 'I', 'R', x ) @ #s) ∧
         (SessionKey( 'R', 'I', k ) @ #sr)) ∧
        (CompleteResp( 'R', 'I', k, x, y ) @ #r)) ∧
       (SessionKey( 'I', 'R', k ) @ #si)) ∧
      (CompleteInit( 'I', 'R', k, x, y ) @ #i)) ∧
     (#s < #r)) ∧
    (#r < #i)"
/*
guarded formula characterizing all satisfying traces:
"∃ k x y #s #sr #si #r #i.
  (InitSend( 'I', 'R', x ) @ #s) ∧
  (SessionKey( 'R', 'I', k ) @ #sr) ∧
  (CompleteResp( 'R', 'I', k, x, y ) @ #r) ∧
  (SessionKey( 'I', 'R', k ) @ #si) ∧
  (CompleteInit( 'I', 'R', k, x, y ) @ #i)
 ∧
  (#s < #r) ∧ (#r < #i)"
*/
by sorry

lemma CompleteResp:
  exists-trace
  "∃ k x y #s #r.
    ((InitSend( 'I', 'R', x ) @ #s) ∧
     (CompleteResp( 'R', 'I', k, x, y ) @ #r)) ∧
    (#s < #r)"
/*
guarded formula characterizing all satisfying traces:
"∃ k x y #s #r.
  (InitSend( 'I', 'R', x ) @ #s) ∧ (CompleteResp( 'R', 'I', k, x, y ) @ #r)
 ∧
  #s < #r"
*/
by sorry

lemma CompleteInit:
  exists-trace
  "∃ ki kr x y #s #r #i.
    ((((InitSend( 'I', 'R', x ) @ #s) ∧
       (CompleteResp( 'R', 'I', kr, x, y ) @ #r)) ∧
      (CompleteInit( 'I', 'R', ki, x, y ) @ #i)) ∧
     (#s < #r)) ∧
    (#r < #i)"
/*
guarded formula characterizing all satisfying traces:
"∃ ki kr x y #s #r #i.
  (InitSend( 'I', 'R', x ) @ #s) ∧
  (CompleteResp( 'R', 'I', kr, x, y ) @ #r) ∧
  (CompleteInit( 'I', 'R', ki, x, y ) @ #i)
 ∧
  (#s < #r) ∧ (#r < #i)"
*/
by sorry

