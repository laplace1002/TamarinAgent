lemma successful_run:
  exists-trace
  "∃ sk #i #j.
    (A_Done( 'A', 'B', sk ) @ #i) ∧ (B_Done( 'A', 'B', sk ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ sk #i #j.
  (A_Done( 'A', 'B', sk ) @ #i) ∧ (B_Done( 'A', 'B', sk ) @ #j)"
*/
by sorry

lemma sk_secret_a:
  all-traces
  "∀ sk #i. (A_Secret( 'A', 'B', sk ) @ #i) ⇒ (¬(∃ #j. K( sk ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ sk #i. (A_Secret( 'A', 'B', sk ) @ #i) ∧ ∃ #j. (K( sk ) @ #j)"
*/
by sorry

lemma sk_secret_b:
  all-traces
  "∀ sk #i. (B_Secret( 'A', 'B', sk ) @ #i) ⇒ (¬(∃ #j. K( sk ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ sk #i. (B_Secret( 'A', 'B', sk ) @ #i) ∧ ∃ #j. (K( sk ) @ #j)"
*/
by sorry

