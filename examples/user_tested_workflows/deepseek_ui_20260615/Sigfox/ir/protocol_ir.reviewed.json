{
  "schema": "autosm_style_protocol_ir_v1",
  "protocol_name": "Sigfox",
  "roles": [
    "A",
    "B"
  ],
  "principals": [
    {
      "name": "A",
      "role_hint": "A"
    },
    {
      "name": "B",
      "role_hint": "B"
    }
  ],
  "crypto": {
    "builtins": [
      "asymmetric-encryption",
      "signature",
      "pairing",
      "symmetric-encryption",
      "signing"
    ],
    "functions": [
      "pk/1"
    ],
    "equations": [],
    "assumptions": []
  },
  "fresh_terms": [
    {
      "name": "~na",
      "owner": "A",
      "purpose": "nonce generated by A"
    }
  ],
  "long_term_keys": [
    {
      "name": "ltkA",
      "owner": "A",
      "public_term": "pk(ltkA)",
      "policy": "private key of A, only known to A"
    },
    {
      "name": "ltkB",
      "owner": "B",
      "public_term": "pk(ltkB)",
      "policy": "private key of B, only known to B"
    }
  ],
  "messages": [
    {
      "label": "M1",
      "step": 1,
      "from": "A",
      "to": "B",
      "protection": "signed asymmetric-encryption",
      "term": "<aenc(<pk(ltkA), ~na>, pk(ltkB)), sign(aenc(<pk(ltkA), ~na>, pk(ltkB)), ltkA)>",
      "meaning": "A sends its public key and fresh nonce encrypted under B's public key, along with a signature over the encrypted message using A's private key",
      "sender_knows": [
        "ltkA",
        "~na",
        "ltkB",
        "A",
        "sends",
        "its",
        "public",
        "key",
        "and",
        "fresh",
        "nonce",
        "encrypted"
      ],
      "receiver_can_decrypt": true,
      "receiver_must_treat_as_opaque": []
    }
  ],
  "actions": [
    {
      "action_id": "A_send_M1",
      "role": "A",
      "kind": "send",
      "generates": [
        "~na"
      ],
      "message_in": [],
      "message_out": [
        "M1"
      ],
      "checks": [],
      "events": [
        "Secret_A(~na)"
      ]
    },
    {
      "action_id": "B_receive_M1",
      "role": "B",
      "kind": "receive",
      "generates": [],
      "message_in": [
        "M1"
      ],
      "message_out": [],
      "checks": [
        "verify signature on encrypted part using pk(ltkA)",
        "decrypt encrypted part using ltkB"
      ],
      "events": [
        "Secret_B(~na)",
        "End()"
      ]
    }
  ],
  "checks": [
    {
      "role": "B",
      "condition": "verify signature on M1's encrypted part using pk(ltkA)",
      "source_message": "M1",
      "action": "B_receive_M1"
    },
    {
      "role": "B",
      "condition": "decrypt encrypted part of M1 using ltkB",
      "source_message": "M1",
      "action": "B_receive_M1"
    }
  ],
  "events": [
    {
      "name": "Secret_A",
      "role": "A",
      "when": "After A generates ~na and sends the signed encrypted notification",
      "arguments": [
        "~na"
      ],
      "proof_relevance": [
        "secret_A",
        "secrecy_PFS_A"
      ]
    },
    {
      "name": "Secret_B",
      "role": "B",
      "when": "After B accepts the decrypted ~na from the verified notification.",
      "arguments": [
        "~na"
      ],
      "proof_relevance": [
        "secret_B"
      ]
    },
    {
      "name": "Role",
      "role": "A",
      "when": "At the start of the server role.",
      "arguments": [
        "'A'"
      ]
    },
    {
      "name": "Send",
      "role": "A",
      "when": "After A constructs the ciphertext and signature, before outputting M1.",
      "arguments": [
        "pk(ltkA)",
        "msg"
      ]
    },
    {
      "name": "Role",
      "role": "B",
      "when": "At the start of the device role",
      "arguments": [
        "'B'"
      ]
    },
    {
      "name": "Recv",
      "role": "B",
      "when": "After B decrypts the ciphertext and verifies the signature",
      "arguments": [
        "pk(ltkB)",
        "msg"
      ]
    },
    {
      "name": "Reveal",
      "role": "Compromise",
      "when": "After the protocol run, if B's long-term decryption key is revealed",
      "arguments": [
        "pk(ltkB)"
      ]
    }
  ],
  "claims": [
    {
      "lemma_name": "executable",
      "goal_type": "executability",
      "expected_state": "ProvedSatisfying",
      "trace_kind": "exists-trace",
      "intent": "the protocol can be executed to completion",
      "event_schema": [
        "Send(pk(ltkA), msg)",
        "Recv(pk(ltkB), msg)"
      ],
      "witness": "B reaches End event"
    },
    {
      "lemma_name": "secret_A",
      "goal_type": "secrecy",
      "expected_state": "ProvedSatisfying",
      "trace_kind": "all-traces",
      "intent": "na remains secret from A's perspective",
      "event_schema": [
        "Secret_A(~na)",
        "Role('A')",
        "K(~na) attack condition",
        "Reveal exception for\n  compromised long-term keys"
      ],
      "witness": "A generated nonce na"
    },
    {
      "lemma_name": "secret_B",
      "goal_type": "secrecy",
      "expected_state": "ProvedSatisfying",
      "trace_kind": "all-traces",
      "intent": "na remains secret from B's perspective",
      "event_schema": [
        "Secret_B(~na)",
        "Role('B')",
        "K(~na) attack condition",
        "Reveal exception for\n  compromised long-term keys"
      ],
      "witness": "B received and accepted nonce"
    },
    {
      "lemma_name": "secrecy_PFS_A",
      "goal_type": "secrecy",
      "expected_state": "CounterexampleFound",
      "trace_kind": "all-traces",
      "intent": "na remains secret even after A's long-term key is compromised (forward secrecy)",
      "event_schema": [
        "Secret_A(~na)",
        "Role('A')",
        "K(~na) attack condition",
        "after-the-fact\n  Reveal(pk(ltkB)) is allowed and should not be excluded"
      ],
      "witness": "A generated nonce"
    }
  ],
  "compromise": {
    "reveal_events": [],
    "policy": "No explicit compromise scenario; assume adversary can reveal long-term keys via Reveal events. Standard Dolev-Yao intruder."
  },
  "abstractions": [
    "Model pairing as <,>",
    "Signature verification is deterministic using public key",
    "A's public key is embedded in encrypted payload as pk(ltkA)"
  ],
  "modeling_assumptions": [
    "Both principals know each other's public keys",
    "Long-term private keys are initially uncompromised",
    "Adversary controls network but cannot break encryption or signature without corresponding private keys",
    "Fresh nonce ~na is generated uniquely"
  ],
