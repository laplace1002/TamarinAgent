theory TPM2_Claim_Profile_Repaired

begin

// Function signature and definition of the equational theory E

functions: cfb/3, cphash/1, create_primary_response/3, fst/1, h/1,
           hmac/2, kdf/2, pair/2, protected_cmd/6, protected_resp/5, rphash/1,
           sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma tpm2_session_command_authentication:
  all-traces
  "∀ hostNonce authHandle encryptedCommandParameter commandHMAC #i.
    (CommandSent( 'H', 'T', hostNonce, authHandle, encryptedCommandParameter,
                  commandHMAC
     ) @ #i) ⇒
    (∃ cpHash tpmNonce #j.
      (CommandHmacComputed( cpHash, hostNonce, tpmNonce, commandHMAC ) @ #j) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ hostNonce authHandle encryptedCommandParameter commandHMAC #i.
  (CommandSent( 'H', 'T', hostNonce, authHandle, encryptedCommandParameter,
                commandHMAC
   ) @ #i)
 ∧
  ∀ cpHash tpmNonce #j.
   (CommandHmacComputed( cpHash, hostNonce, tpmNonce, commandHMAC ) @ #j)
  ⇒
   ¬(#j < #i)"
*/
by sorry

lemma tpm2_session_response_authentication:
  all-traces
  "∀ rpHash tpmNonce hostNonce expectedHMAC receivedHMAC #i.
    (ResponseHmacVerified( rpHash, tpmNonce, hostNonce, expectedHMAC,
                           receivedHMAC
     ) @ #i) ⇒
    (∃ rc encryptedParameters #j.
      (ResponseReceived( rc, tpmNonce, encryptedParameters, receivedHMAC
       ) @ #j) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ rpHash tpmNonce hostNonce expectedHMAC receivedHMAC #i.
  (ResponseHmacVerified( rpHash, tpmNonce, hostNonce, expectedHMAC,
                         receivedHMAC
   ) @ #i)
 ∧
  ∀ rc encryptedParameters #j.
   (ResponseReceived( rc, tpmNonce, encryptedParameters, receivedHMAC
    ) @ #j)
  ⇒
   ¬(#j < #i)"
*/
by sorry

lemma tpm2_session_command_payload_confidentiality:
  all-traces
  "∀ commandParameter encryptedParameter aesKeyAndIV #i.
    (CommandParameterEncrypted( commandParameter, encryptedParameter,
                                aesKeyAndIV
     ) @ #i) ⇒
    (¬(∃ #j. K( commandParameter ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ commandParameter encryptedParameter aesKeyAndIV #i.
  (CommandParameterEncrypted( commandParameter, encryptedParameter,
                              aesKeyAndIV
   ) @ #i)
 ∧
  ∃ #j. (K( commandParameter ) @ #j)"
*/
by sorry

lemma tpm2_session_response_payload_confidentiality:
  all-traces
  "∀ encryptedParameter decryptedParameter aesDecKeyAndIV #i.
    (ResponseParameterDecrypted( encryptedParameter, decryptedParameter,
                                 aesDecKeyAndIV
     ) @ #i) ⇒
    (¬(∃ #j. K( decryptedParameter ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ encryptedParameter decryptedParameter aesDecKeyAndIV #i.
  (ResponseParameterDecrypted( encryptedParameter, decryptedParameter,
                               aesDecKeyAndIV
   ) @ #i)
 ∧
  ∃ #j. (K( decryptedParameter ) @ #j)"
*/
by sorry

lemma tpm2_session_key_secrecy:
  all-traces
  "∀ authHandle tpmNonce sessionKey #i.
    (SessionKeyDerived( authHandle, tpmNonce, sessionKey ) @ #i) ⇒
    (¬(∃ #j. K( sessionKey ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ authHandle tpmNonce sessionKey #i.
  (SessionKeyDerived( authHandle, tpmNonce, sessionKey ) @ #i)
 ∧
  ∃ #j. (K( sessionKey ) @ #j)"
*/
by sorry

lemma tpm2_session_salt_secrecy:
  all-traces
  "∀ ecdhSharedSecret sessionSalt #i.
    (SaltDerived( ecdhSharedSecret, sessionSalt ) @ #i) ⇒
    (¬(∃ #j. K( sessionSalt ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ ecdhSharedSecret sessionSalt #i.
  (SaltDerived( ecdhSharedSecret, sessionSalt ) @ #i)
 ∧
  ∃ #j. (K( sessionSalt ) @ #j)"
*/
by sorry

lemma tpm2_null_key_public_material_validation:
  all-traces
  "∀ keyhandle nullKeyX nullKeyY name #i.
    (NullKeyPublicMaterialAccepted( keyhandle, nullKeyX, nullKeyY, name
     ) @ #i) ⇒
    (name = <nullKeyX, nullKeyY>)"
/*
guarded formula characterizing all counter-examples:
"∃ keyhandle nullKeyX nullKeyY name #i.
  (NullKeyPublicMaterialAccepted( keyhandle, nullKeyX, nullKeyY, name
   ) @ #i)
 ∧
  ¬(name = <nullKeyX, nullKeyY>)"
*/
by sorry

lemma tpm2_initial_create_primary_mitm_attack:
  exists-trace
  "∃ attackerKeyX attackerKeyY #i #j #k.
    ((((CreatePrimarySent( 'H', 'T' ) @ #i) ∧
       (AttackerModifiedResponse( attackerKeyX, attackerKeyY ) @ #j)) ∧
      (CreatePrimaryResponseReceived( 'H', 'fakeHandle',
                                      <attackerKeyX, attackerKeyY>
       ) @ #k)) ∧
     (#i < #j)) ∧
    (#j < #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ attackerKeyX attackerKeyY #i #j #k.
  (CreatePrimarySent( 'H', 'T' ) @ #i) ∧
  (AttackerModifiedResponse( attackerKeyX, attackerKeyY ) @ #j) ∧
  (CreatePrimaryResponseReceived( 'H', 'fakeHandle',
                                  <attackerKeyX, attackerKeyY>
   ) @ #k)
 ∧
  (#i < #j) ∧ (#j < #k)"
*/
by sorry

lemma tpm2_continued_session_state_reset:
  all-traces
  "∀ authHandle sessionKey tpmNonce hostNonce #i.
    (SessionContinued( authHandle, sessionKey, tpmNonce, hostNonce ) @ #i) ⇒
    (∃ #j.
      (SessionKeyDerived( authHandle, tpmNonce, sessionKey ) @ #j) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ authHandle sessionKey tpmNonce hostNonce #i.
  (SessionContinued( authHandle, sessionKey, tpmNonce, hostNonce ) @ #i)
 ∧
  ∀ #j.
   (SessionKeyDerived( authHandle, tpmNonce, sessionKey ) @ #j)
  ⇒
   ¬(#j < #i)"
*/
by sorry

lemma tpm2_session_termination_cleanup:
  all-traces
  "∀ authHandle #i.
    (SessionTerminated( authHandle ) @ #i) ⇒
    (∃ tpmNonce sessionKey #j.
      (SessionKeyDerived( authHandle, tpmNonce, sessionKey ) @ #j) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ authHandle #i.
  (SessionTerminated( authHandle ) @ #i)
 ∧
  ∀ tpmNonce sessionKey #j.
   (SessionKeyDerived( authHandle, tpmNonce, sessionKey ) @ #j)
  ⇒
   ¬(#j < #i)"
*/
by sorry

